APP_ENV=development
DATABASE_URL=sqlite:///./leadspr.db
FRONTEND_URL=http://localhost:3000
ADMIN_API_TOKEN=

# Single-line JSON from a Google service account key; never commit the real key.
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success?order_id={PUBLIC_ID}
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel

RESEND_API_KEY=
EMAIL_FROM=

APP_TIMEZONE=America/Puerto_Rico
DAILY_SYNC_TIME=02:00
SCHEDULER_ENABLED=true
